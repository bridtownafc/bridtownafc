---
// The club's official social channels, from Site settings in the CMS. Only channels the club
// has entered are shown; nothing is shown until then.
import { club } from '@/data/club';

const channels = [
  { label: 'Facebook', url: club.social.facebook },
  { label: 'Instagram', url: club.social.instagram },
  { label: 'X', url: club.social.x },
  { label: 'YouTube', url: club.social.youtube },
].filter((c): c is { label: string; url: string } => Boolean(c.url));
---
{channels.length > 0 && (
  <ul class="social-links" role="list">
    {channels.map((c) => <li><a href={c.url} rel="noopener me">{c.label}<span class="visually-hidden"> (Bridlington Town AFC official account)</span></a></li>)}
  </ul>
)}
<style>
  .social-links { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 0; padding: 0; list-style: none; background: #444; }
  .social-links a { display: grid; min-height: 90px; place-items: center; background: #202020; font: 800 1.25rem var(--display); text-decoration: none; text-transform: uppercase; }
  .social-links a:hover, .social-links a:focus-visible { background: var(--red); }
</style>
