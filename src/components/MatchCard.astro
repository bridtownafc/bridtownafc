---
import { sectionHref, type TeamId } from '@/data/teams';

interface Props { type: 'next' | 'result'; team: TeamId; }
const { type, team } = Astro.props;
const isNext = type === 'next';
---
<article class:list={['fixture-card', !isNext && 'result-card']}>
  <header><span>{isNext ? 'Next match' : 'Latest result'}</span><small>Official data pending</small></header>
  <div class="fixture-meta"><span>Competition TBC</span><span>Date TBC</span></div>
  <div class="teams">
    <div class="team home"><img src="/assets/brand/brid-town-badge-black.png" alt="" width="1323" height="1189" /><strong>Bridlington Town</strong></div>
    <div class="score" aria-label={isNext ? 'Kick-off time to be confirmed' : 'Score to be confirmed'}>{isNext ? 'TBC' : '–'}</div>
    <div class="team"><span class="opponent-badge" aria-hidden="true">?</span><strong>Opponent TBC</strong></div>
  </div>
  <div class="fixture-detail"><span>Venue TBC</span><span>{isNext ? 'Kick-off TBC' : 'Match report pending'}</span></div>
  <a class="fixture-action" href={sectionHref(team, isNext ? 'matches' : 'news')}>{isNext ? 'Match information' : 'Match report'} <span aria-hidden="true">→</span></a>
</article>

<style>
  .fixture-card { overflow: hidden; border: 1px solid #333; background: #161616; }
  .fixture-card header { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; color: #fff; background: var(--red); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .fixture-card header small { opacity: .8; }
  .result-card header { color: var(--ink); background: #fff; }
  .fixture-meta, .fixture-detail { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1.25rem; color: #aaa; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
  .fixture-meta { border-bottom: 1px solid #333; }
  .fixture-detail { border-top: 1px solid #333; }
  .teams { display: grid; grid-template-columns: 1fr 74px 1fr; align-items: center; gap: .75rem; padding: 1.5rem 1rem; color: #fff; }
  .team { display: grid; justify-items: center; gap: .65rem; text-align: center; }
  .team img, .opponent-badge { width: 68px; height: 68px; object-fit: contain; }
  .opponent-badge { display: grid; place-items: center; border: 2px solid #555; color: #777; font: 900 1.6rem var(--display); }
  .team strong { font-family: var(--display); font-size: 1.25rem; line-height: 1; text-transform: uppercase; }
  .score { color: #fff; font: 900 2rem var(--display); text-align: center; }
  .fixture-action { display: flex; justify-content: space-between; padding: 1rem 1.25rem; color: #fff; background: #252525; font-family: var(--display); font-weight: 800; text-decoration: none; text-transform: uppercase; }
  @media(max-width: 420px) { .teams { grid-template-columns: 1fr 50px 1fr; } .team img, .opponent-badge { width: 52px; height: 52px; } }
</style>
