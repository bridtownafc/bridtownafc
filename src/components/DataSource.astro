---
// Where a team's match data comes from, when it was last updated, and a clear notice if
// the latest update failed. Never claims live scores, and never shows configuration details.
import { stamp } from '@/lib/matches/format';
import type { TeamMatches } from '@/lib/matches';

interface Props { data: TeamMatches; }
const { data } = Astro.props;
const { snapshot, source, stale, embedCodes } = data;
const lastSuccess = snapshot.sync.lastSuccessAt;
---
<div class="data-source">
  {embedCodes
    ? <p>Shown directly from <a href={source.url} rel="noopener">FA Full-Time</a>, the FA's official competition system, where the team is listed as {source.listedAs}.</p>
    : lastSuccess
      ? <p>{source.attribution}. Last updated {stamp(lastSuccess)} UK time. Results appear once the competition confirms them; this is not a live score service. <a href={source.officialTableUrl} rel="noopener">Official league table</a>.</p>
      : <p>{source.league}. See the official <a href={source.officialFixturesUrl} rel="noopener">fixtures and results</a> and <a href={source.officialTableUrl} rel="noopener">league table</a>.</p>}
  {stale && (
    <p class="stale" role="status">
      <strong>These details may be out of date.</strong> {lastSuccess ? `They were last updated at ${stamp(lastSuccess)}.` : ''} Please check the <a href={source.officialFixturesUrl} rel="noopener">official fixtures</a> for the latest.
    </p>
  )}
</div>
<style>
  .data-source { font-size: .9rem; color: var(--muted); }
  .data-source p { margin: 0 0 .5rem; }
  .data-source a { color: var(--red); font-weight: 700; text-underline-offset: 3px; }
  .stale { padding: .75rem 1rem; border-left: 4px solid #e0a100; color: var(--ink); background: #fff6db; }
</style>
