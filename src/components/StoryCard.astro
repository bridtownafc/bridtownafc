---
// A news story card. Full articles link to their own page; others to their target page.
import { storyHref, type Story, type TeamId } from '@/data/teams';

interface Props { team: TeamId; story: Story; featured?: boolean; headingLevel?: 'h2' | 'h3'; }
const { team, story, featured = false, headingLevel: Heading = 'h3' } = Astro.props;
const date = story.publishedAt ? new Date(story.publishedAt) : null;
const webp = story.image?.src.replace(/\.(jpe?g|png)$/i, '.webp');
---
<article class:list={['story-card', featured && 'featured', story.image && 'has-image']}>
  {story.image && (
    <picture class="story-media">
      <source type="image/webp" srcset={webp} />
      <img src={story.image.src} alt={story.image.alt} width={story.image.width} height={story.image.height} loading="lazy" decoding="async" />
    </picture>
  )}
  <div class="story-content">
    <p class="story-meta"><span>{story.category}</span>{date && <time datetime={story.publishedAt}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London' })}</time>}</p>
    <Heading><a href={storyHref(team, story)}>{story.title}</a></Heading>
    <p>{story.summary}</p>
  </div>
</article>
<style>
  .story-card { position: relative; display: grid; align-content: start; border-top: 5px solid var(--red); background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .story-media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--mist); }
  .story-media img { width: 100%; height: 100%; object-fit: cover; }
  .story-content { padding: 1.5rem; }
  .story-meta { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .story-meta span { color: var(--red); }
  .story-card h2, .story-card h3 { margin-bottom: .75rem; font-size: 1.9rem; }
  .featured h2, .featured h3 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); }
  .story-card a { text-decoration: none; }
  /* The whole card is clickable through the heading link. */
  .story-card a::after { content: ''; position: absolute; inset: 0; }
  .story-card:hover h2, .story-card:hover h3 { color: var(--red); }
  .story-card a:focus-visible { outline: none; }
  .story-card:focus-within { outline: 3px solid var(--red); outline-offset: 3px; }
  .story-content p:last-child { margin-bottom: 0; }
</style>
