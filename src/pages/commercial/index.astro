---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import { commercialOptions } from '@/data/commercial';
import { club, telHref } from '@/data/club';

const subjectFor = (title: string) => `Sponsorship enquiry: ${title}`;
---
<BaseLayout title="Sponsorship and Advertising | Bridlington Town AFC" description="Partner with Bridlington Town AFC through sponsorship, advertising and matchday opportunities. Contact the club to discuss the right package for your business.">
  <PageHero eyebrow="Partner with the Seasiders" title="Football. Community. Business." introduction="Build visibility, local relationships and real community value through a partnership with Bridlington Town AFC." />
  <section class="section"><div class="shell">
    <div class="section-head"><div><p class="eyebrow">Current opportunities</p><h2>Back the club</h2></div><p class="section-copy">From an accessible matchday package to a principal partnership, we will shape the right package for your organisation. Contact us to discuss sponsorship.</p></div>
    <ul class="grid-2 packages" role="list">
      {commercialOptions.map((item) => (
        <li class="package">
          <div><span class="label">{item.category}</span><h3>{item.title}</h3><p>{item.detail}</p></div>
          <a class="package-cta" href={`#enquire`} data-enquiry-subject={subjectFor(item.title)}>Contact us to discuss <span class="visually-hidden">{item.title}</span><span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </div></section>
  <section class="section dark-surface"><div class="shell value-grid"><div><p class="eyebrow light">Bigger partnerships</p><h2>Make your mark on the next chapter</h2><p>Every partnership is tailored. Tell us what you would like to achieve and we will put together a proposal.</p></div><ul class="value-list" role="list"><li>Principal club partnership</li><li>Stadium and stand naming rights</li><li>Home, away and training-wear sponsorship</li><li>Events, hospitality and bespoke campaigns</li></ul></div></section>
  <section id="enquire" class="section enquire"><div class="shell enquiry">
    <div>
      <p class="eyebrow">Start a conversation</p>
      <h2>Contact us to discuss sponsorship</h2>
      <p>Tell us about your business and what you would like to achieve, and the club will be in touch to talk through the options.</p>
      <p class="direct">Prefer to talk? Call the club on <a href={telHref(club.contactPhone)}>{club.contactPhone}</a>{club.contactEmail && <> or email <a href={`mailto:${club.contactEmail}`}>{club.contactEmail}</a></>}.</p>
    </div>
    <EnquiryForm topic="commercial" subjectFrom="data-enquiry-subject" />
  </div></section>
</BaseLayout>
<style>
  .section-copy { max-width: 430px; }
  .packages { margin: 0; padding: 0; list-style: none; }
  .package { display: flex; min-height: 190px; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding: 1.75rem; border: 1px solid var(--line); border-top: 5px solid var(--red); }
  .package h3 { font-size: 2rem; }
  .package p { margin-bottom: 0; }
  .package-cta { display: inline-flex; align-self: start; gap: .5rem; color: var(--red); font: 800 1.1rem var(--display); text-transform: uppercase; text-underline-offset: 4px; }
  .value-grid { display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 4rem; }
  .value-list { margin: 0; padding: 0; list-style: none; }
  .value-list li { padding: 1rem 0; border-bottom: 1px solid #444; font-family: var(--display); font-size: 1.5rem; font-weight: 700; text-transform: uppercase; }
  .enquire { background: var(--mist); }
  .enquiry { display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: 4rem; }
  .direct a { color: var(--red); font-weight: 800; }
  @media (max-width: 850px) { .value-grid, .enquiry { grid-template-columns: 1fr; gap: 2rem; } }
</style>
