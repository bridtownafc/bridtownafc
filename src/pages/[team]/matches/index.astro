---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import MatchList from '@/components/MatchList.astro';
import LeagueTable from '@/components/LeagueTable.astro';
import FullTimeEmbed from '@/components/FullTimeEmbed.astro';
import DataSource from '@/components/DataSource.astro';
import { TICKETED_TEAMS, TICKETS_URL } from '@/data/club';
import { TEAM_IDS, teams, type TeamId } from '@/data/teams';
import { teamMatches } from '@/lib/matches';

export function getStaticPaths() {
  return TEAM_IDS.map((team) => ({ params: { team } }));
}

const teamId = Astro.params.team as TeamId;
const team = teams[teamId];
const data = teamMatches(teamId);
const { source } = data;
const embed = data.embedCodes;
const season = data.snapshot.season;
const sells = TICKETED_TEAMS.includes(teamId);
const synced = Boolean(data.snapshot.sync.lastSuccessAt);
// Separate fixtures/results snippets take their own sections; a combined one sits under Fixtures.
const fixturesCode = embed?.fixtures || embed?.fixturesResults;
const resultsCode = embed?.results || '';
---
<BaseLayout team={teamId} section="matches" title={`Fixtures, Results and Table | ${team.name} | Bridlington Town AFC`} description={`Bridlington Town AFC ${team.phrase} fixtures, results and ${source.league} table for ${season}.`}>
  <PageHero eyebrow={`${team.name} · ${season}`} title="Match Centre" introduction={team.matches.introduction} />
  <section class="section match-centre-page">
    <div class="shell">
      <nav class="match-nav" aria-label="Match Centre sections"><a href="#fixtures">Fixtures</a><a href="#results">Results</a><a href="#table">League table</a></nav>
      <DataSource data={data} />
      {sells && (
        <aside class="tickets-note" aria-label="Tickets">
          <p><strong>Home match tickets</strong> are sold through the club's official ticket website.</p>
          <a class="button" href={TICKETS_URL} rel="noopener">Buy tickets</a>
        </aside>
      )}

      <section id="fixtures" class="block" aria-labelledby="fixtures-title">
        <h2 id="fixtures-title">{fixturesCode && !resultsCode && embed?.fixturesResults ? 'Fixtures and results' : 'Fixtures'}</h2>
        {fixturesCode
          ? <FullTimeEmbed code={fixturesCode} title={embed?.fixtures ? 'Fixtures' : 'Fixtures and results'} source={source} />
          : data.fixtures.length
            ? <MatchList matches={data.fixtures} team={teamId} kind="fixtures" />
            : <p class="unavailable">{synced ? 'No upcoming fixtures have been published.' : 'Fixtures are not available here yet.'} <a href={source.officialFixturesUrl} rel="noopener">See the official fixtures</a>.</p>}
      </section>

      <section id="results" class="block" aria-labelledby="results-title">
        <h2 id="results-title">Results</h2>
        {resultsCode
          ? <FullTimeEmbed code={resultsCode} title="Results" source={source} />
          : fixturesCode
            ? <p class="unavailable">Results are included in the fixtures and results above.</p>
            : data.results.length
              ? <MatchList matches={data.results} team={teamId} kind="results" />
              : <p class="unavailable">{synced ? `No results have been confirmed for ${season} yet.` : 'Results are not available here yet.'} <a href={source.officialFixturesUrl} rel="noopener">See the official results</a>.</p>}
        {data.other.length > 0 && (
          <div class="other">
            <h3>Cancelled, abandoned or void</h3>
            <MatchList matches={data.other} team={teamId} kind="other" />
          </div>
        )}
      </section>

      <section id="table" class="block" aria-labelledby="table-title">
        <h2 id="table-title">League table</h2>
        <p class="league-name">{source.league}</p>
        {embed?.table
          ? <FullTimeEmbed code={embed.table} title="League table" source={source} href={source.officialTableUrl} />
          : data.table
            ? <LeagueTable table={data.table} />
            : <p class="unavailable">The table is not available here yet. <a href={source.officialTableUrl} rel="noopener">See the official league table</a>.</p>}
      </section>
    </div>
  </section>
</BaseLayout>
<style>
  .match-nav { position: sticky; top: 0; z-index: 5; display: flex; overflow-x: auto; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line); gap: 2rem; background: #fff; }
  .match-nav a { padding: .9rem 0; font: 800 1.15rem var(--display); text-decoration: none; text-transform: uppercase; white-space: nowrap; }
  .match-nav a:hover, .match-nav a:focus-visible { color: var(--red); box-shadow: inset 0 -4px 0 var(--red); }
  .tickets-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin: 1.5rem 0 0; padding: 1rem 1.25rem; border-left: 5px solid var(--red); background: var(--mist); }
  .tickets-note p { margin: 0; }
  .block { padding-top: 3rem; scroll-margin-top: 4rem; }
  .block h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .league-name { margin-top: -.5rem; color: var(--muted); font-weight: 700; }
  .unavailable { max-width: 760px; padding: 1.25rem 1.5rem; border-left: 5px solid var(--red); background: var(--mist); }
  .unavailable a { color: var(--red); font-weight: 800; }
  .other { margin-top: 2.5rem; }
</style>
