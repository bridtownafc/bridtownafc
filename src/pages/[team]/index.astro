---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MatchCard from '@/components/MatchCard.astro';
import LeaguePreview from '@/components/LeaguePreview.astro';
import SponsorStrip from '@/components/SponsorStrip.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import EmptyState from '@/components/EmptyState.astro';
import Logo from '@/components/Logo.astro';
import StoryCard from '@/components/StoryCard.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { TICKETED_TEAMS, TICKETS_URL, club } from '@/data/club';
import { TEAM_IDS, linkFor, sectionHref, teams, type TeamId } from '@/data/teams';

export function getStaticPaths() {
  return TEAM_IDS.map((team) => ({ params: { team } }));
}

const teamId = Astro.params.team as TeamId;
const team = teams[teamId];
const shared = (path: string, hash?: string) => linkFor(teamId, { shared: path, hash });
const hasSquad = team.players.length > 0;
const sells = TICKETED_TEAMS.includes(teamId);
const stories = team.news.slice(0, 3);
const hasSocial = Object.values(club.social).some(Boolean);
---

<BaseLayout team={teamId} section="home" title={`${team.name} | Bridlington Town AFC | Official Website`} description={`The official home of Bridlington Town AFC's ${team.phrase}: fixtures, results, league table, squad and news.`}>
  <section class="home-hero dark-surface">
    <div class="shell hero-content">
      <Logo tone="dark" alt="Bridlington Town AFC club crest" sizes="(max-width: 560px) 96px, (max-width: 850px) 120px, 200px" class="hero-badge" eager />
      <div>
        <p class="eyebrow light">Bridlington Town AFC · {team.name}</p>
        <h1>Our town.<br /><span>Our team.</span></h1>
        <p class="hero-copy">{team.home.introduction}</p>
        <div class="hero-actions">
          <a class="button" href={sectionHref(teamId, 'matches')}>Fixtures and results</a>
          {sells
            ? <a class="button outline" href={TICKETS_URL} rel="noopener">Buy tickets</a>
            : <a class="button outline" href={sectionHref(teamId, 'team')}>Meet the squad</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="match-centre dark-surface" aria-label={`Latest ${team.phrase} match information`}>
    <div class="shell match-grid"><MatchCard type="next" team={teamId} /><MatchCard type="result" team={teamId} /></div>
  </section>

  <section class="quick-strip" aria-label="Quick links"><div class="shell quick-grid">
    <a href={sectionHref(teamId, 'matches')}><strong>Fixtures and results</strong><span>Follow the {team.phrase}</span></a>
    <a href={sectionHref(teamId, 'team')}><strong>Meet the team</strong><span>{hasSquad ? `${team.players.length} players` : 'Squad to be announced'}</span></a>
    {sells
      ? <a href={TICKETS_URL} rel="noopener"><strong>Tickets</strong><span>Buy home match tickets online</span></a>
      : <a href={shared('/club/', 'matchday')}><strong>Plan your visit</strong><span>Matchday information</span></a>}
    <a href={shared('/commercial/')}><strong>Back Brid Town</strong><span>Sponsorship and advertising</span></a>
  </div></section>

  <section class="section news-section"><div class="shell">
    <SectionHeading eyebrow={team.name} title="Latest news" linkLabel={`All ${team.label.toLowerCase()} news`} linkHref={sectionHref(teamId, 'news')} />
    {stories.length > 0
      ? <div class="news-layout">{stories.map((story, index) => <StoryCard team={teamId} story={story} featured={index === 0} headingLevel="h3" />)}</div>
      : <EmptyState headingLevel="h3" title={team.newsPage.emptyTitle} text={team.newsPage.emptyText} />}
  </div></section>

  <section class="section season-section"><div class="shell season-grid">
    <LeaguePreview team={teamId} />
    <div class="community-panel">
      <p class="eyebrow">Our town. Our club.</p>
      <h2>At the heart of Bridlington</h2>
      <p>Bridlington Town AFC belongs to the community around it: supporters, volunteers, players, staff and the local businesses that back the club.</p>
      <div class="cta-row"><a class="button outline" href={shared('/club/')}>About the club</a><a class="text-link" href={shared('/club/', 'matchday')}>Plan your visit <span aria-hidden="true">→</span></a></div>
    </div>
  </div></section>

  <section class="section commercial-callout"><div class="shell commercial-grid"><div><p class="eyebrow light">Business meets football</p><h2>Put your business behind the Seasiders</h2></div><div><p>From matchday visibility to principal partnerships, work with a club carrying the pride and ambition of Bridlington.</p><div class="cta-row"><a class="button light" href={shared('/commercial/', 'enquire')}>Contact us to discuss sponsorship</a><a class="text-link" href={shared('/commercial/')}>See the opportunities <span aria-hidden="true">→</span></a></div></div></div></section>

  <SponsorStrip />

  {hasSocial && (
    <section class="section social-section dark-surface"><div class="shell social-grid"><div><p class="eyebrow light">Follow the Seasiders</p><h2>Stay close to the club</h2><p>News, team announcements and matchday updates on the club's official channels.</p></div><SocialLinks /></div></section>
  )}
</BaseLayout>

<style>
  .home-hero { position: relative; overflow: hidden; background: radial-gradient(circle at 18% 40%, #2a0d12 0, var(--ink) 55%); }
  .home-hero::after { content: ''; position: absolute; right: -10%; bottom: 0; width: 55%; height: 10px; background: var(--red); }
  .hero-content { position: relative; z-index: 1; display: grid; min-height: min(640px, 76vh); grid-template-columns: 200px minmax(0, 760px); align-items: center; gap: 3rem; padding-block: 4.5rem; }
  .hero-content :global(.hero-badge) { width: 200px; height: auto; filter: drop-shadow(0 8px 20px rgba(0, 0, 0, .45)); }
  .hero-content h1 { margin-bottom: 1rem; }
  .hero-content h1 span { color: #ef5261; }
  .hero-copy { max-width: 650px; color: #eee; font-size: 1.15rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .match-centre { padding: 0 0 3rem; }
  .match-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; max-width: 1000px; }
  .quick-strip { border-bottom: 1px solid var(--line); background: #fff; }
  .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .quick-grid a { display: grid; min-height: 120px; align-content: center; padding: 1.25rem; border-right: 1px solid var(--line); border-top: 4px solid transparent; text-decoration: none; }
  .quick-grid a:hover, .quick-grid a:focus-visible { border-top-color: var(--red); background: var(--mist); }
  .quick-grid a:first-child { border-left: 1px solid var(--line); }
  .quick-grid strong { font-family: var(--display); font-size: 1.45rem; text-transform: uppercase; }
  .quick-grid span { color: var(--muted); font-size: .85rem; }
  .news-layout { display: grid; grid-template-columns: 1.35fr .65fr; gap: 1.25rem; }
  .news-layout > :global(:not(.featured)) { grid-column: 2; }
  .news-layout > :global(.featured) { grid-row: span 2; }
  .season-section { background: var(--mist); }
  .season-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .community-panel { padding: clamp(1.5rem, 4vw, 3rem); border-top: 5px solid var(--red); background: #fff; }
  .commercial-callout { position: relative; overflow: hidden; color: #fff; background: var(--red); }
  .commercial-grid { position: relative; display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: 4rem; }
  .commercial-grid h2 { margin: 0; }
  .cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 1.5rem; }
  .text-link { font-weight: 800; text-underline-offset: 4px; }
  .social-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; }
  @media (max-width: 850px) {
    .hero-content { grid-template-columns: 120px 1fr; gap: 1.5rem; }
    .hero-content :global(.hero-badge) { width: 120px; }
    .match-grid, .season-grid, .commercial-grid, .social-grid, .news-layout { grid-template-columns: minmax(0, 1fr); }
    .news-layout > :global(*) { grid-column: auto !important; grid-row: auto !important; }
    .quick-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .hero-content { min-height: auto; grid-template-columns: 1fr; padding-block: 3rem; }
    .hero-content :global(.hero-badge) { width: 96px; }
    .quick-grid { grid-template-columns: 1fr; }
    .quick-grid a { min-height: 90px; border-left: 1px solid var(--line); }
  }
</style>
