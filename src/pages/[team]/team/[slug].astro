---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlayerPhoto from '@/components/PlayerPhoto.astro';
import { TEAM_IDS, profileHref, sectionHref, teams, type Player, type TeamId } from '@/data/teams';

export function getStaticPaths() {
  // Only teams with confirmed players get profile pages; an empty squad produces none.
  return TEAM_IDS.flatMap((teamId) => {
    const players = teams[teamId].players;
    return players.map((player, index) => ({
      params: { team: teamId, slug: player.slug },
      props: {
        teamId,
        player,
        previous: players[(index - 1 + players.length) % players.length],
        next: players[(index + 1) % players.length],
      },
    }));
  });
}

interface Props { teamId: TeamId; player: Player; previous: Player; next: Player; }
const { teamId, player, previous, next } = Astro.props;
const team = teams[teamId];
const squadHref = `${sectionHref(teamId, 'team')}#squad`;
---
<BaseLayout team={teamId} section="team" title={`${player.name} | ${team.name} | Bridlington Town AFC`} description={`Player profile for ${player.name} of the Bridlington Town AFC ${team.phrase}.`}>
  <section class="profile-hero red-surface">
    <div class="shell profile-grid">
      <PlayerPhoto team={team} player={player} sizes="(max-width: 760px) calc(100vw - 2rem), 440px" eager class="profile-photo" />
      <div class="profile-intro">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={sectionHref(teamId, 'home')}>{team.label}</a> <span aria-hidden="true">/</span> <a href={squadHref}>{team.name} squad</a>
        </nav>
        <p class="eyebrow light">{team.name}</p>
        <h1>{player.name}</h1>
        <p class="profile-pending">Position, squad number, biography and statistics will be added once confirmed by the club.</p>
        <a class="button light" href={squadHref}><span aria-hidden="true">←</span>&nbsp;Back to the squad</a>
      </div>
    </div>
  </section>
  <nav class="section profile-pager" aria-label="More players">
    <div class="shell pager-grid">
      <a href={profileHref(teamId, previous)} rel="prev"><small><span aria-hidden="true">←</span> Previous player</small><strong>{previous.name}</strong></a>
      <a href={profileHref(teamId, next)} rel="next"><small>Next player <span aria-hidden="true">→</span></small><strong>{next.name}</strong></a>
    </div>
  </nav>
</BaseLayout>
<style>
  .profile-hero { padding: clamp(2.5rem, 6vw, 5rem) 0; }
  .profile-grid { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .profile-grid :global(.profile-photo) { box-shadow: 0 18px 40px rgba(0, 0, 0, .3); }
  .profile-intro h1 { margin-bottom: 1.25rem; font-size: clamp(3.4rem, 8vw, 7rem); overflow-wrap: anywhere; }
  .breadcrumbs { margin-bottom: 1.5rem; font-size: .85rem; }
  .breadcrumbs a { text-underline-offset: 3px; }
  .profile-pending { max-width: 520px; margin-bottom: 1.75rem; color: #f6d9dc; }
  .profile-pager { padding-block: 2.5rem; }
  .pager-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .pager-grid a { display: flex; flex-direction: column; gap: .25rem; padding: 1.1rem 1.25rem; border: 1px solid var(--line); text-decoration: none; }
  .pager-grid a:last-child { align-items: end; text-align: right; }
  .pager-grid a:hover { border-color: var(--red); }
  .pager-grid small { color: var(--red); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .pager-grid strong { font-family: var(--display); font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  @media (max-width: 760px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-grid :global(.profile-photo) { max-width: 420px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 460px) { .pager-grid strong { font-size: 1.25rem; } }
</style>
