---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { TICKETS_URL, club, mapsHref, telHref } from '@/data/club';
---
<BaseLayout title="The Club | Bridlington Town AFC" description={`About Bridlington Town AFC, and matchday information for the ${club.groundName}: getting here, tickets and accessibility.`}>
  <PageHero eyebrow="Bridlington Town AFC" title="Proud of our past. Building our future." introduction="A football club rooted in its town, powered by its people and ambitious about what comes next." />
  <section class="section"><div class="shell grid-2">
    <article>
      <p class="eyebrow">Our club</p>
      <h2>Bridlington's team</h2>
      <p>From generations of supporters to the volunteers, players, staff and businesses carrying the club forward, Bridlington Town AFC belongs to the community around it.</p>
      <p>The club's men's first team plays in the Northern Premier League East Division, and its women's first team represents the Seasiders in women's football.</p>
      <div class="cta-row"><a class="button" href="/mens/">Men's first team</a><a class="button outline" href="/womens/">Women's first team</a></div>
    </article>
    <div class="history-panel"><span>The Seasiders</span><p>Club history, honours and records will be published here once they have been checked against the club's records.</p></div>
  </div></section>
  <section id="matchday" class="section matchday"><div class="shell">
    <p class="eyebrow">Plan your visit</p>
    <h2>Matchday at Brid Town</h2>
    <div class="grid-3">
      <div class="card">
        <h3>Getting here</h3>
        <p>Home matches are played at the <strong>{club.groundName}</strong>.</p>
        <address>{club.address}</address>
        <a class="card-link" href={mapsHref} rel="noopener">Open in Google Maps <span aria-hidden="true">→</span></a>
      </div>
      <div class="card">
        <h3>Tickets and admission</h3>
        <p>Match tickets and season tickets, with current admission prices, are on the club's official ticket website.</p>
        <a class="card-link" href={TICKETS_URL} rel="noopener">Buy tickets <span aria-hidden="true">→</span></a>
      </div>
      <div class="card" id="accessibility">
        <h3>Accessibility</h3>
        <p>If you have access needs or would like help planning your visit, please call the club before the match on <a href={telHref(club.contactPhone)}>{club.contactPhone}</a> or <a href="/contact/#enquire">send an enquiry</a>.</p>
      </div>
    </div>
  </div></section>
</BaseLayout>
<style>
  .history-panel { display: grid; min-height: 320px; align-content: end; padding: 2rem; color: #fff; background: var(--ink); }
  .history-panel span { color: #ef5261; font: 900 clamp(3.5rem, 9vw, 6.5rem)/.85 var(--display); text-transform: uppercase; }
  .history-panel p { max-width: 420px; margin: 1.5rem 0 0; color: #d7d7d7; }
  .matchday { background: var(--mist); }
  .cta-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  address { margin-bottom: .5rem; font-style: normal; }
  .card a:not(.card-link) { color: var(--red); font-weight: 700; }
</style>
