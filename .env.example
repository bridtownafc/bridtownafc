# Website and match-data settings. Copy to .env (ignored by Git). Never commit .env.

# Football Web Pages API (men's first team). Free for a non-league club's official website:
# request a key by email from https://www.footballwebpages.co.uk/api, then run
# `npm run matches:discover` to find FWP_TEAM_ID.
FWP_API_KEY=
FWP_TEAM_ID=

# How `npm run matches:watch` rebuilds the site when data changes: listener | local | none
MATCHES_REBUILD=listener

# Enquiry form relay (npm run cms:enquiries). Without it, forms show the club's phone number.
PUBLIC_ENQUIRY_ENDPOINT=http://127.0.0.1:4410/enquiry
