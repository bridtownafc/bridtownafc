# Template for cms/.env. Run `npm run cms:env` to create cms/.env with fresh random
# secrets; it never overwrites an existing file. Never commit cms/.env.
# Values marked __GENERATE__ are replaced with random values.

# Docker services
DB_PASSWORD=__GENERATE__
DIRECTUS_SECRET=__GENERATE__
# Open Innovation Grant key, once the club receives it. Empty = Core tier.
DIRECTUS_LICENSE_KEY=

# Initial Super Admin (first start only). Sign in, then set up 2FA straight away.
ADMIN_EMAIL=superadmin@example.com
ADMIN_PASSWORD=__GENERATE__

# Publishing: Directus -> rebuild listener (npm run cms:listen)
REBUILD_HOOK_SECRET=__GENERATE__
REBUILD_LISTEN_PORT=4400

# Website build: read-only, published content only. Filled in by `npm run cms:bootstrap`.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_WEBSITE_TOKEN=
